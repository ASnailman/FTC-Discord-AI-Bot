# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required. Discord bot token from the Developer Portal's Bot tab.
# See docs/setup-discord.md for how to create the application and bot.
DISCORD_TOKEN=

# Required. Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Set this during development for instant guild-scoped slash
# command sync. Leave unset for global sync (takes up to ~1 hour to
# propagate, but works in every server the bot is invited to).
# Right-click your Discord server icon -> Copy Server ID (requires Developer
# Mode enabled in Discord settings).
DISCORD_GUILD_ID=

# --- Everything below is optional; defaults live in src/config.py ---

# Where the ChromaDB vector store is persisted.
# CHROMA_PATH=./src/chroma_db
# CHROMA_COLLECTION=ftc_team_data

# Sentence-transformer model used for embeddings.
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Gemini model used for answer generation.
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
# GEMINI_TEMPERATURE=0.0
# GEMINI_MAX_TOKENS=1024
# Used instead of GEMINI_MAX_TOKENS only when external community context is
# actually fused into the prompt (see docs/nodes.md) -- the plain-lookup
# path keeps GEMINI_MAX_TOKENS unchanged.
# GEMINI_MAX_TOKENS_WITH_CONTEXT=2048

# Number of chunks retrieved per question.
# RETRIEVAL_K=40

# How long a cached team/season is trusted before re-fetching, for the
# current (still-changing) season only. Past seasons are cached forever.
# CACHE_TTL_HOURS=24

# How long the local team-name index cache is trusted before re-downloading.
# TEAMS_INDEX_TTL_DAYS=7
# Directory the team-name index JSON cache is written to.
# TEAMS_INDEX_DIR=./src/data

# LOG_LEVEL=INFO

# --- Multi-source retrieval pipeline (docs/nodes.md, docs/adr/0003) ---
# All optional. The bot behaves identically to before this pipeline existed
# if nothing below is set: Chief Delphi is on (no auth needed), YouTube is
# off, Reddit self-disables without credentials, and the LLM router only
# ever runs for a question no deterministic rule matched.

# Chief Delphi needs no credentials -- it's a public search endpoint.
# ENABLE_CHIEF_DELPHI=true

# Uncomment and set both to enable the Reddit (r/FTC) source. Create a
# "script" app at https://www.reddit.com/prefs/apps -- no username/password
# needed, this uses Reddit's read-only application-only auth flow.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=ftc-scouting-bot/0.1 by u/<your-reddit-username>

# Off by default: the slowest, least reliable source (a web search plus a
# per-video caption fetch, and many videos have no captions at all).
# ENABLE_YOUTUBE=false

# Whether an unrouted question gets one structured-output Gemini call to
# classify its intent, vs. falling back to {stats, chroma} directly.
# ENABLE_LLM_ROUTER=true

# Per-node timeout and total pipeline time budget, in seconds, for the
# stats/chroma/external nodes run concurrently by chain.answer.
# NODE_TIMEOUT_SECONDS=6
# PIPELINE_BUDGET_SECONDS=12

# How long a Chief Delphi/Reddit/YouTube search result is cached in-process
# before repeating the same question re-hits the API.
# EXTERNAL_CACHE_TTL_MINUTES=60

# Caps on how much external text is fused into one prompt.
# MAX_EXTERNAL_CHARS_PER_SOURCE=3000
# MAX_EXTERNAL_CHARS_TOTAL=8000

# Caps on how many results each source contributes before fusion.
# CHIEF_DELPHI_MAX_POSTS=5
# REDDIT_MAX_POSTS=5
# YOUTUBE_MAX_VIDEOS=2
