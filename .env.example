# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required. Discord bot token from the Developer Portal's Bot tab.
# See docs/setup-discord.md for how to create the application and bot.
DISCORD_TOKEN=

# Required. Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Set this during development for instant guild-scoped slash
# command sync. Leave unset for global sync (takes up to ~1 hour to
# propagate, but works in every server the bot is invited to).
# Right-click your Discord server icon -> Copy Server ID (requires Developer
# Mode enabled in Discord settings).
DISCORD_GUILD_ID=

# --- Everything below is optional; defaults live in src/config.py ---

# Where the ChromaDB vector store is persisted.
# CHROMA_PATH=./src/chroma_db

# Sentence-transformer model used for embeddings.
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Gemini model used for answer generation.
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
# GEMINI_TEMPERATURE=0.0
# GEMINI_MAX_TOKENS=1024

# Number of chunks retrieved per question.
# RETRIEVAL_K=40

# How long a cached team/season is trusted before re-fetching, for the
# current (still-changing) season only. Past seasons are cached forever.
# CACHE_TTL_HOURS=24

# How long the local team-name index cache is trusted before re-downloading.
# TEAMS_INDEX_TTL_DAYS=7

# LOG_LEVEL=INFO
